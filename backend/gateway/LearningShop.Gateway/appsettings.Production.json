{
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/cart/{**catch-all}" }
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://products:5001/" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://orders:5002/" }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://cart:5003/" }
        }
      }
    }
  }
}