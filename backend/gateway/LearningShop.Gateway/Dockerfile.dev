FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src
COPY backend/shared/LearningShop.MessageBus/LearningShop.MessageBus.csproj backend/shared/LearningShop.MessageBus/
COPY backend/gateway/LearningShop.Gateway/LearningShop.Gateway.csproj backend/gateway/LearningShop.Gateway/
RUN dotnet restore "backend/gateway/LearningShop.Gateway/LearningShop.Gateway.csproj"
COPY backend/shared/LearningShop.MessageBus/ backend/shared/LearningShop.MessageBus/
COPY backend/gateway/LearningShop.Gateway/ backend/gateway/LearningShop.Gateway/

WORKDIR /src/backend/gateway/LearningShop.Gateway
RUN dotnet build -c Debug

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS runtime

WORKDIR /app
COPY --from=build /src .
ENV DOTNET_WATCH_NO_LAUNCHER=1
ENV ASPNETCORE_URLS=http://0.0.0.0:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "watch", "run", "--project", "/app/backend/gateway/LearningShop.Gateway/LearningShop.Gateway.csproj"]