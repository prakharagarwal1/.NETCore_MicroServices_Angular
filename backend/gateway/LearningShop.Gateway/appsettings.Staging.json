{
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://products:5101/" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://orders:5102/" }
        }
      }
    }
  }
}